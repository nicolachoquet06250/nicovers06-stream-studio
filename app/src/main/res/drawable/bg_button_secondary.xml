<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_raised" />
            <stroke android:width="1dp" android:color="@color/purple_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#101A28" android:startColor="#1A2738" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
